    },
    {
      "label": "Privacy",
      "resource": "legal/PRIVACY-NOTICE.md",
    },
  ],
  "thirdPartyDocuments": [
    {
      "label": "Third-party notices",
      "resource": "legal/THIRD_PARTY_NOTICES.txt",
    },
    {
      "label": "MPL source code",
      "resource": "legal/MPL-SOURCE-ACCESS.txt",
    },
  ],
