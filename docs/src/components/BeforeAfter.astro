---
// Shows a capture source and its pasted result side by side, joined by an arrow.
// Stacks vertically on narrow screens, with the arrow pointing down.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  beforeAlt: string;
  after: ImageMetadata;
  afterAlt: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const {
  before,
  beforeAlt,
  after,
  afterAlt,
  beforeLabel = 'Captured',
  afterLabel = 'Pasted',
} = Astro.props;
---

<figure class="before-after not-content">
  <div class="panel">
    <span class="label">{beforeLabel}</span>
    <Image src={before} alt={beforeAlt} widths={[480, 960]} sizes="(min-width: 50rem) 22rem, 100vw" />
  </div>
  <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <div class="panel">
    <span class="label">{afterLabel}</span>
    <Image src={after} alt={afterAlt} widths={[480, 960]} sizes="(min-width: 50rem) 22rem, 100vw" />
  </div>
</figure>

<style>
  .before-after {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    align-items: center;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }
  .label {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .panel :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-hairline);
  }
  .arrow {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--sl-color-accent-high);
    transform: rotate(90deg);
  }
  @media (min-width: 50rem) {
    .before-after {
      grid-template-columns: 1fr auto 1fr;
    }
    .arrow {
      transform: none;
    }
  }
</style>
