---
// Logo plus the white Sora wordmark used on isoboard.app, followed by a muted "Docs" label.
import { logos } from 'virtual:starlight/user-images';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label="isoboard Docs home">
  {logos.dark && <img src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} alt="" />}
  <span class="wordmark" translate="no">isoboard</span>
  <span class="section">Docs</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--isoboard-heading-font);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  img {
    height: 1.625rem;
    width: auto;
  }
  .section {
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }
</style>
