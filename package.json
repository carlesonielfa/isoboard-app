{
  "name": "isoboard",
  "version": "1.0.0",
  "description": "Turn screenshots and images into content you can paste into other apps",
  "private": true,
  "type": "module",
  "scripts": {
    "menu-icons": "bun scripts/export-menu-icons.mjs",
    "dev": "bun run bindings && vite dev",
    "build": "bun run bindings && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "bun run bindings && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:unused": "svelte-kit sync && knip-bun --include files",
    "test": "bun run bindings && bun test",
    "format": "prettier --write 'src/**/*.{js,ts,svelte,css}' 'tests/**/*.ts' 'src/app.html' '*.config.js' 'knip.ts' '.prettierrc' 'package.json' 'tsconfig.json' 'config/*.jsonc'",
    "format:check": "prettier --check 'src/**/*.{js,ts,svelte,css}' 'tests/**/*.ts' 'src/app.html' '*.config.js' 'knip.ts' '.prettierrc' 'package.json' 'tsconfig.json' 'config/*.jsonc'",
    "lint": "eslint . --max-warnings 0",
    "tauri": "tauri",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --example export_bindings -- src/lib/generated/bindings.ts"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.45.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "^1.4.2",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "knip": "^6.42.1",
    "paneforge": "^1.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16"
  }
}
