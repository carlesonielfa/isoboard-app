{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "isoboard",
  "version": "1.1.0",
  "identifier": "app.isoboard",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "isoboard",
        "theme": "Dark",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "decorations": true,
        "resizable": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 16
        },
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 29
        }
      },
      {
        "label": "capture-overlay",
        "url": "/overlay",
        "title": "Capture status",
        "acceptFirstMouse": true,
        "theme": "Dark",
        "width": 288,
        "height": 60,
        "visible": false,
        "focusable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzNkQ1RDU1NzE4MEVGRUIKUldUcjc0QnhWVjF0QTQ3OXp6d1d4T0RTTXQ5d0s1VXZTMERBcFhOdmVxb1ZwYzhPbUpPNFpuRnUK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Carles Onielfa Pérez",
    "copyright": "Copyright © 2026 Carles Onielfa Pérez",
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "gen/legal/": "legal/"
    }
  }
}
